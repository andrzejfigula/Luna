# Copy this file to .env and fill in your key:
#     cp .env.example .env
# .env is git-ignored — never commit your real key.

# Required. Used for chat + vision (gpt-4.1-mini), speech-to-text
# (gpt-4o-mini-transcribe) and text-to-speech (gpt-4o-mini-tts).
OPENAI_API_KEY=sk-your_key_here

# ── Optional hardware overrides (leave empty for auto-detect) ─────────────────

# Camera: V4L2 index or device path.   e.g. 0   or   /dev/video2
LUNA_CAMERA=

# Microphone: sounddevice index or part of the device name.   e.g. C270
# List: ./venv/bin/python -c "import sounddevice; print(sounddevice.query_devices())"
LUNA_MIC=

# Speaker: jack | hdmi | bluetooth | default | <PipeWire node name>
# ("jack" = the Pi's 3.5 mm output; "default" = whatever the desktop uses)
# List: wpctl status
LUNA_SPEAKER=jack

# Voice: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer,
# verse, marin, cedar   (nova / shimmer / marin are the bright, friendly ones)
LUNA_TTS_VOICE=marin

# Touchscreen backlight, percent (the DSI panel boots at ~30 %).
LUNA_BRIGHTNESS=100

# Live camera preview in the bottom-right corner of the face (debug / aiming).
# 1 = on (160 px wide), a number = width in px, empty/0 = off.
LUNA_CAMERA_PREVIEW=

# Keep the last N utterances (WAV + Vosk/cloud transcripts) in stt_log/ to
# review misrecognitions. Stores your voice on the Pi — leave empty normally.
LUNA_STT_SAVE=
