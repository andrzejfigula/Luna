# Copy this file to .env and fill in your key:
#     cp .env.example .env
#
# .env is git-ignored — never commit your real key.
# Used for chat + vision (gpt-4.1-mini), speech-to-text (gpt-4o-mini-transcribe)
# and text-to-speech (gpt-4o-mini-tts). Without it Luna only animates.

OPENAI_API_KEY=sk-your_key_here
